# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Dashboard → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clase-bachata

# Emails (Google) que pueden subir vídeos, separados por coma
ALLOWED_EMAILS=profe1@gmail.com,profe2@gmail.com

# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare API token (Workers R2 Storage: Edit) — solo para wrangler/scripts, nunca NEXT_PUBLIC_
CLOUDFLARE_API_TOKEN=
